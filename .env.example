# ---------------------------------------------------------------------------
# Frontend (Vercel) — all optional. Every page except /ask is prerendered from
# committed data and needs none of this.
# ---------------------------------------------------------------------------

# Enables /ask. Without it the page renders a clear notice instead of failing.
# WARNING: with this set, /api/chat is a public unauthenticated LLM endpoint.
# Rate-limit it before making the deployment public (atlas-gx3e).
ANTHROPIC_API_KEY=sk-ant-...

# The Render API. When set, the chat route's retrieval uses the FTS5 index;
# when unset it falls back to the local corpus scan, so leaving this empty is a
# supported configuration rather than a broken one.
ATLAS_API_URL=https://karamazov-atlas-api.onrender.com

# ---------------------------------------------------------------------------
# Backend (Render) — set in the Render dashboard, not here.
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API. Set to the Vercel URL.
# Not "*": the API would otherwise serve as anyone's backend.
# ALLOWED_ORIGINS=https://karamazov-atlas.vercel.app
